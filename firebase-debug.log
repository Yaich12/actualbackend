[debug] [2026-03-07T21:18:34.169Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/actualbackend-3b454/rulesets {"name":"projects/actualbackend-3b454/rulesets/1f8d671f-3432-4669-bfc9-bcd208a6ab9c","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return isSignedIn() && request.auth.uid == userId;\n    }\n\n    function isClinicOwner(clinicId) {\n      return isSignedIn()\n        && exists(/databases/$(database)/documents/clinics/$(clinicId))\n        && get(/databases/$(database)/documents/clinics/$(clinicId)).data.ownerUid == request.auth.uid;\n    }\n\n    function isClinicMember(clinicId) {\n      return isSignedIn()\n        && exists(/databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid));\n    }\n\n    function userActiveClinicId(userId) {\n      return get(/databases/$(database)/documents/users/$(userId)).data.activeClinicId;\n    }\n\n    function isWorkspaceOwnerUser(userId) {\n      return isSignedIn()\n        && exists(/databases/$(database)/documents/users/$(userId))\n        && userActiveClinicId(userId) != null\n        && exists(/databases/$(database)/documents/clinics/$(userActiveClinicId(userId)))\n        && get(/databases/$(database)/documents/clinics/$(userActiveClinicId(userId))).data.ownerUid == userId;\n    }\n\n    function isWorkspaceMemberForOwner(userId) {\n      return isSignedIn()\n        && isWorkspaceOwnerUser(userId)\n        && exists(/databases/$(database)/documents/clinics/$(userActiveClinicId(userId))/members/$(request.auth.uid));\n    }\n\n    // Personal profile data (per-user, not shared clinic workspace data).\n    match /users/{userId} {\n      allow read, write: if isOwner(userId) || isWorkspaceMemberForOwner(userId);\n\n      // Personal nested data remains per-user.\n      match /{document=**} {\n        allow read, write: if isOwner(userId) || isWorkspaceMemberForOwner(userId);\n      }\n    }\n\n    match /publicClinics/{clinicSlug} {\n      allow read: if resource.data.isActive == true;\n      allow create: if isSignedIn()\n        && request.resource.data.ownerUid == request.auth.uid;\n      allow update: if isSignedIn()\n        && resource.data.ownerUid == request.auth.uid\n        && request.resource.data.ownerUid == resource.data.ownerUid;\n      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;\n    }\n\n    match /clinics/{clinicId} {\n      allow read: if isClinicOwner(clinicId) || isClinicMember(clinicId);\n      allow create: if isSignedIn()\n        && request.resource.data.ownerUid == request.auth.uid;\n      allow update: if isClinicOwner(clinicId) || isClinicMember(clinicId);\n      allow delete: if false;\n\n      match /members/{memberUid} {\n        allow read: if isClinicOwner(clinicId) || isClinicMember(clinicId);\n        allow create, update, delete: if isClinicOwner(clinicId) || isClinicMember(clinicId);\n      }\n\n      // Shared clinic workspace data:\n      // appointments, clients, services, sales, settings, etc.\n      match /{document=**} {\n        allow read, write: if isClinicOwner(clinicId) || isClinicMember(clinicId);\n      }\n    }\n\n    // Default deny for anything outside /users/{userId}/...\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-03-07T21:18:34.203487Z","metadata":{"services":["cloud.firestore"]}}
